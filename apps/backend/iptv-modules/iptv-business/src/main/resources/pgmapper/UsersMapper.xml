<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iptv.business.pgmapper.UsersMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iptv.business.domain.Users">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="avatar" property="avatar"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="is_active" property="isActive"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="can_access_all_tenants" property="canAccessAllTenants"/>
        <result column="preferences" property="preferences"/>
        <result column="is_system_admin" property="isSystemAdmin"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, username, email, password_hash, avatar, tenant_id, is_active, created_at, updated_at, deleted_at, can_access_all_tenants, preferences, is_system_admin
    </sql>

    <!-- 分页查询（PostgreSQL：字符串使用 ILIKE 大小写不敏感模糊查询） -->
    <select id="queryPage" resultMap="BaseResultMap" parameterType="com.iptv.business.domain.dto.page.UsersPageDTO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM users
        <where>
            deleted_at IS NULL
            <if test="param.id != null and param.id != ''">
                AND id ILIKE CONCAT('%', #{param.id}, '%')
            </if>
            <if test="param.username != null and param.username != ''">
                AND username ILIKE CONCAT('%', #{param.username}, '%')
            </if>
            <if test="param.email != null and param.email != ''">
                AND email ILIKE CONCAT('%', #{param.email}, '%')
            </if>
            <if test="param.passwordHash != null and param.passwordHash != ''">
                AND password_hash ILIKE CONCAT('%', #{param.passwordHash}, '%')
            </if>
            <if test="param.avatar != null and param.avatar != ''">
                AND avatar ILIKE CONCAT('%', #{param.avatar}, '%')
            </if>
            <if test="param.tenantId != null">
                AND tenant_id = #{param.tenantId}
            </if>
            <if test="param.isActive != null">
                AND is_active = #{param.isActive}
            </if>
            <if test="param.createdAt != null">
                AND created_at = #{param.createdAt}
            </if>
            <if test="param.updatedAt != null">
                AND updated_at = #{param.updatedAt}
            </if>
            <if test="param.deletedAt != null">
                AND deleted_at = #{param.deletedAt}
            </if>
            <if test="param.canAccessAllTenants != null">
                AND can_access_all_tenants = #{param.canAccessAllTenants}
            </if>
            <if test="param.preferences != null and param.preferences != ''">
                AND preferences ILIKE CONCAT('%', #{param.preferences}, '%')
            </if>
            <if test="param.isSystemAdmin != null">
                AND is_system_admin = #{param.isSystemAdmin}
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
