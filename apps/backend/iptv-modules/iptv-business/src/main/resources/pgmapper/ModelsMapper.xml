<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iptv.business.pgmapper.ModelsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iptv.business.domain.Models">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="name" property="name"/>
        <result column="display_name" property="displayName"/>
        <result column="type" property="type"/>
        <result column="source" property="source"/>
        <result column="description" property="description"/>
        <result column="parameters" property="parameters"/>
        <result column="is_default" property="isDefault"/>
        <result column="is_builtin" property="isBuiltin"/>
        <result column="managed_by" property="managedBy"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, tenant_id, name, display_name, type, source, description, parameters,
        is_default, is_builtin, managed_by, status, created_at, updated_at, deleted_at
    </sql>

    <!-- 分页查询（PostgreSQL：字符串使用 ILIKE 大小写不敏感模糊查询） -->
    <select id="queryPage" resultMap="BaseResultMap" parameterType="com.iptv.business.domain.dto.page.ModelsPageDTO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM models
        <where>
            deleted_at IS NULL
            <if test="param.id != null and param.id != ''">
                AND id ILIKE CONCAT('%', #{param.id}, '%')
            </if>
            <if test="param.tenantId != null">
                AND tenant_id = #{param.tenantId}
            </if>
            <if test="param.name != null and param.name != ''">
                AND name ILIKE CONCAT('%', #{param.name}, '%')
            </if>
            <if test="param.displayName != null and param.displayName != ''">
                AND display_name ILIKE CONCAT('%', #{param.displayName}, '%')
            </if>
            <if test="param.type != null and param.type != ''">
                AND type = #{param.type}
            </if>
            <if test="param.source != null and param.source != ''">
                AND source = #{param.source}
            </if>
            <if test="param.description != null and param.description != ''">
                AND description ILIKE CONCAT('%', #{param.description}, '%')
            </if>
            <if test="param.isDefault != null">
                AND is_default = #{param.isDefault}
            </if>
            <if test="param.isBuiltin != null">
                AND is_builtin = #{param.isBuiltin}
            </if>
            <if test="param.status != null and param.status != ''">
                AND status = #{param.status}
            </if>
            <if test="param.createdAt != null">
                AND created_at = #{param.createdAt}
            </if>
            <if test="param.updatedAt != null">
                AND updated_at = #{param.updatedAt}
            </if>
        </where>
        ORDER BY id DESC
    </select>


    <!-- 查询租户模型列表 -->
    <select id="selectListByTenantId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM models
        WHERE tenant_id = #{tenantId}
          AND deleted_at IS NULL
        ORDER BY created_at DESC
    </select>

    <!-- 查询所有模型（包括内置） -->
    <select id="selectAllModels" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM models
        WHERE deleted_at IS NULL
        ORDER BY is_builtin DESC, created_at DESC
    </select>

</mapper>
