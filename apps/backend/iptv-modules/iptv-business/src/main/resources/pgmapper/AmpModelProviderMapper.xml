<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iptv.business.pgmapper.AmpModelProviderMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iptv.business.domain.AmpModelProvider">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="display_name" property="displayName"/>
        <result column="description" property="description"/>
        <result column="default_urls" property="defaultUrls" typeHandler="com.iptv.common.core.typehandler.JsonbTypeHandler"/>
        <result column="model_types" property="modelTypes" typeHandler="com.iptv.common.core.typehandler.JsonbTypeHandler"/>
        <result column="requires_auth" property="requiresAuth"/>
        <result column="extra_fields" property="extraFields" typeHandler="com.iptv.common.core.typehandler.JsonbTypeHandler"/>
        <result column="enabled" property="enabled"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, display_name, description, default_urls, model_types, requires_auth, extra_fields, enabled, sort_order, created_at, updated_at
    </sql>

</mapper>
