<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iptv.business.pgmapper.CustomAgentMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iptv.business.domain.CustomAgent">
        <id column="id" property="id"/>
        <id column="tenant_id" property="tenantId"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="avatar" property="avatar"/>
        <result column="is_builtin" property="isBuiltin"/>
        <result column="created_by" property="createdBy"/>
        <result column="config" property="config" typeHandler="com.iptv.common.core.typehandler.JsonbTypeHandler"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="runnable_by_viewer" property="runnableByViewer"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, description, avatar, is_builtin, tenant_id, created_by, config, created_at, updated_at, deleted_at, runnable_by_viewer
    </sql>

    <!-- 查询所有未删除的智能体 -->
    <select id="listAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM custom_agents
        WHERE deleted_at IS NULL
        ORDER BY is_builtin DESC, created_at DESC
    </select>

    <!-- 根据ID和租户ID查询智能体 -->
    <select id="selectByIdAndTenantId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM custom_agents
        WHERE id = #{id}
          AND deleted_at IS NULL
    </select>

    <!-- 查询内置智能体列表 -->
    <select id="selectBuiltinAgents" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM custom_agents
        WHERE is_builtin = true
          AND deleted_at IS NULL
        ORDER BY id
    </select>

    <!-- 批量查询用户信息 -->
    <select id="selectUsersByIds" resultType="com.iptv.business.pgmapper.CustomAgentMapper$UserInfo">
        SELECT
            user_id as userId,
            user_name as userName,
            display_name as displayName
        FROM sys_user
        WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>

    <!-- 查询租户禁用的智能体ID列表 -->
    <select id="selectDisabledOwnAgentIds" resultType="java.lang.String">
        SELECT agent_id
        FROM tenant_disabled_shared_agents
        WHERE tenant_id = #{tenantId}
    </select>

</mapper>
