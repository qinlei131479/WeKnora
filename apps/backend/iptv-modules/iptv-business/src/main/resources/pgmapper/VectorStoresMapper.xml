<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iptv.business.pgmapper.VectorStoresMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.iptv.business.domain.VectorStores">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="engine_type" property="engineType"/>
        <result column="connection_config" property="connectionConfig"/>
        <result column="index_config" property="indexConfig"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, engine_type, connection_config, index_config, tenant_id, created_at, updated_at, deleted_at
    </sql>

    <!-- 分页查询（PostgreSQL：字符串使用 ILIKE 大小写不敏感模糊查询） -->
    <select id="queryPage" resultMap="BaseResultMap" parameterType="com.iptv.business.domain.dto.page.VectorStoresPageDTO">
        SELECT
        <include refid="Base_Column_List"/>
        FROM vector_stores
        <where>
            <if test="param.id != null and param.id != ''">
                AND id ILIKE CONCAT('%', #{param.id}, '%')
            </if>
            <if test="param.name != null and param.name != ''">
                AND name ILIKE CONCAT('%', #{param.name}, '%')
            </if>
            <if test="param.engineType != null and param.engineType != ''">
                AND engine_type ILIKE CONCAT('%', #{param.engineType}, '%')
            </if>
            <if test="param.connectionConfig != null and param.connectionConfig != ''">
                AND connection_config ILIKE CONCAT('%', #{param.connectionConfig}, '%')
            </if>
            <if test="param.indexConfig != null and param.indexConfig != ''">
                AND index_config ILIKE CONCAT('%', #{param.indexConfig}, '%')
            </if>
            <if test="param.tenantId != null">
                AND tenant_id = #{param.tenantId}
            </if>
            <if test="param.createdAt != null">
                AND created_at = #{param.createdAt}
            </if>
            <if test="param.updatedAt != null">
                AND updated_at = #{param.updatedAt}
            </if>
            <if test="param.deletedAt != null">
                AND deleted_at = #{param.deletedAt}
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
