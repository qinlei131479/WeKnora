<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iptv.system.mapper.SysOperLogMapper">

	<resultMap type="com.iptv.system.api.domain.SysOperLog" id="SysOperLogResult">
		<id     property="operId"         column="oper_id"        />
		<result property="title"          column="title"          />
		<result property="businessType"   column="business_type"  />
		<result property="method"         column="method"         />
		<result property="requestMethod"  column="request_method" />
		<result property="operatorType"   column="operator_type"  />
		<result property="operName"       column="oper_name"      />
		<result property="deptName"       column="dept_name"      />
		<result property="operUrl"        column="oper_url"       />
		<result property="operIp"         column="oper_ip"        />
		<result property="operParam"      column="oper_param"     />
		<result property="jsonResult"     column="json_result"    />
		<result property="status"         column="status"         />
		<result property="errorMsg"       column="error_msg"      />
		<result property="operTime"       column="oper_time"      />
		<result property="costTime"       column="cost_time"      />
	</resultMap>

	<sql id="selectOperLogVo">
        select oper_id, title, business_type, method, request_method, operator_type, oper_name, dept_name, oper_url, oper_ip, oper_param, json_result, status, error_msg, oper_time, cost_time
        from sys_oper_log
    </sql>
    
	<insert id="insertOperlog" parameterType="com.iptv.system.api.domain.SysOperLog">
		insert into sys_oper_log(title, business_type, method, request_method, operator_type, oper_name, dept_name, oper_url, oper_ip, oper_param, json_result, status, error_msg, cost_time, oper_time)
        values (#{title}, #{businessType}, #{method}, #{requestMethod}, #{operatorType}, #{operName}, #{deptName}, #{operUrl}, #{operIp}, #{operParam}, #{jsonResult}, #{status}, #{errorMsg}, #{costTime}, sysdate())
	</insert>
	
	<select id="selectOperLogList" parameterType="com.iptv.system.api.domain.SysOperLog" resultMap="SysOperLogResult">
		<include refid="selectOperLogVo"/>
		<where>
			<if test="param.operIp != null and param.operIp != ''">
				AND oper_ip like concat('%', #{param.operIp}, '%')
			</if>
			<if test="param.title != null and param.title != ''">
				AND title like concat('%', #{param.title}, '%')
			</if>
			<if test="param.businessType != null">
				AND business_type = #{param.businessType}
			</if>
			<if test="param.businessTypes != null and param.businessTypes.length > 0">
			    AND business_type in
			    <foreach collection="param.businessTypes" item="businessType" open="(" separator="," close=")">
		 			#{param.businessType}
		        </foreach> 
			</if>
			<if test="param.status != null">
				AND status = #{param.status}
			</if>
			<if test="param.operName != null and param.operName != ''">
				AND oper_name like concat('%', #{param.operName}, '%')
			</if>
			<if test="param.params.beginTime != null and param.params.beginTime != ''"><!-- 开始时间检索 -->
				AND oper_time &gt;= #{param.params.beginTime}
			</if>
			<if test="param.params.endTime != null and param.params.endTime != ''"><!-- 结束时间检索 -->
				AND oper_time &lt;= #{param.params.endTime}
			</if>
		</where>
		order by oper_id desc
	</select>
	
	<delete id="deleteOperLogByIds" parameterType="Long">
 		delete from sys_oper_log where oper_id in
 		<foreach collection="array" item="operId" open="(" separator="," close=")">
 			#{operId}
        </foreach> 
 	</delete>
 	
 	<select id="selectOperLogById" parameterType="Long" resultMap="SysOperLogResult">
		<include refid="selectOperLogVo"/>
		where oper_id = #{operId}
	</select>
	
	<update id="cleanOperLog">
        truncate table sys_oper_log
    </update>

</mapper> 