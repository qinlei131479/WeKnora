# kjsc 镜像构建 ignorefile（不改官方根 .dockerignore）
# 用法：支持 --ignorefile 的 Buildx 直接传入；旧版 Buildx 由
# scripts/kjsc/build_images.sh 回退使用根 .dockerignore。
# 覆盖官方忽略规则，并排除企业侧不进 app/docreader/sandbox 镜像的目录。

# VCS / CI
.git/
.github/
.gitignore
.gitattributes

# 编辑器 / IDE 本地配置
.cursor/
.claude/
.codebuddy/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python 虚拟环境 / 缓存
**/.venv/
.venv_proto/
**/.python-version
**/__pycache__/
**/*.pyc

# Node / 前端（app/docreader/sandbox 不打前端源码）
**/node_modules/
frontend/
apps/frontend/
apps/docs/
WeKnora-Chrome-Extension/

# 其它企业产品线（本镜像不构建）
apps/manager/
apps/backend/
apps/agent-harness/

# 日志 / 临时文件
logs/
tmp/
temp/
*.log
*.pid

# 本地构建产物 / 二进制
WeKnora
WeKnora-lite
/server
/dist/
/build/
third_party/anydoc-go/target/
third_party/anydoc-go/lib/
third_party/anydoc-go/.anydoc-*.crate
third_party/anydoc-go/.anydoc-unpack/
/artifacts/browserskill/
cmd/desktop/build/bin/

# 本地数据 / 模型文件
/models/
data/files/
data/*.db
data/*.db-wal
data/*.db-shm
test/data/mswag.txt

# 敏感文件
.env
.env.lite
*.pem
*.key
*.crt
*_key
*_secret

# 大的归档/压缩包
packages/protoc-*.zip
!packages/protoc-*-linux-x86_64.zip
!packages/protoc-*-linux-aarch_64.zip
!packages/protoc-*-linux-arm.zip

# 本地测试脚本
configure-ollama.sh
fix-docker.sh
/scripts/scale_dev_jobs.sh
