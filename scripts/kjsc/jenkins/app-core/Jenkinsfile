// 后端 App 流水线（agent-middle / kjsc）
// Jenkins Script Path: scripts/kjsc/jenkins/app-core/Jenkinsfile
// 依赖：postgres/redis/docreader 已运行；Jenkins 用户可执行 docker
// Go/Rust 均在 Docker builder 内安装，Jenkins 宿主机不需要配置 Go 或 Cargo
// 若无 .env，部署阶段会从 .env.kjsc.example 复制生成

pipeline {
    agent any

    environment {
        CONTAINER_NAME = 'agent-middle-app'
        COMPOSE_SERVICE = 'app'
        COMPOSE_NETWORK = 'agent-middle-network'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(name: 'SKIP_BUILD', defaultValue: false, description: '跳过构建，仅重启容器')
        booleanParam(
            name: 'WITH_ANYDOC',
            defaultValue: true,
            description: '链接 anydoc 进程内 Office 解析引擎；首次构建会安装 Rust 工具链，耗时和磁盘占用更高'
        )
        string(
            name: 'RUSTUP_DIST_SERVER',
            defaultValue: '',
            description: '可选 Rust 工具链镜像；留空时读取 .env，最终默认 https://static.rust-lang.org'
        )
        string(
            name: 'RUSTUP_UPDATE_ROOT',
            defaultValue: '',
            description: '可选 Rustup 更新镜像；留空时读取 .env，最终默认 https://static.rust-lang.org/rustup'
        )
        booleanParam(
            name: 'OVERWRITE_ENV',
            defaultValue: false,
            description: '强制用 .env.kjsc.example 覆盖 .env（覆盖前自动备份；会丢失工作区内对 .env 的手工修改）'
        )
    }

    stages {
        stage('检出') {
            steps {
                checkout scm
            }
        }

        stage('构建') {
            // 与 UI 相同提供 SKIP_BUILD；此处用 toString 判断，避免 Jenkins 传入字符串时 !params.SKIP_BUILD 失效
            when {
                expression { return params.SKIP_BUILD?.toString() != 'true' }
            }
            steps {
                withEnv([
                    "WITH_ANYDOC=${params.WITH_ANYDOC?.toString()}",
                    "RUSTUP_DIST_SERVER=${params.RUSTUP_DIST_SERVER?.trim() ?: ''}",
                    "RUSTUP_UPDATE_ROOT=${params.RUSTUP_UPDATE_ROOT?.trim() ?: ''}"
                ]) {
                    sh 'sh scripts/kjsc/build_images.sh -p'
                }
            }
        }

        stage('部署') {
            steps {
                withEnv(["OVERWRITE_ENV=${params.OVERWRITE_ENV?.toString()}"]) {
                    sh '''
                        set -e
                        test -f .env.kjsc.example
                        if [ "$OVERWRITE_ENV" = "true" ]; then
                          if [ -f .env ]; then
                            cp .env ".env.bak.$(date +%Y%m%d%H%M%S)"
                            echo "已备份旧 .env"
                          fi
                          cp .env.kjsc.example .env
                          echo "[OVERWRITE_ENV] 已强制从 .env.kjsc.example 覆盖 .env"
                        elif [ ! -f .env ]; then
                          cp .env.kjsc.example .env
                          echo "已从 .env.kjsc.example 生成 .env"
                        else
                          echo "保留现有 .env（未勾选覆盖）"
                        fi
                        docker network inspect "$COMPOSE_NETWORK" >/dev/null 2>&1 || docker network create "$COMPOSE_NETWORK"
                        docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
                        docker compose -f docker-compose-kjsc.yml up -d --no-deps --force-recreate --pull never "$COMPOSE_SERVICE"
                    '''
                }
            }
        }

        stage('检查') {
            steps {
                sh '''
                    set -e
                    # 与 .env 中 APP_PORT 一致；未配置时默认 9980
                    port=$(grep -E '^APP_PORT=' .env 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d ' "\t\r' || true)
                    port=${port:-9980}
                    echo "健康检查: http://localhost:${port}/health"
                    for i in $(seq 1 30); do
                      curl -fsS "http://localhost:${port}/health" && exit 0
                      sleep 2
                    done
                    docker logs --tail=50 "$CONTAINER_NAME" || true
                    exit 1
                '''
            }
        }
    }
}
