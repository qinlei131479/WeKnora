// sandbox-provisioner 流水线（agent-middle / kjsc）
// Jenkins Script Path: scripts/kjsc/jenkins/sandbox/Jenkinsfile
// 独立于 harness api/worker。现网必须 --profile harness --profile minio 且 --no-deps
// 若无 .env，部署阶段会从 .env.kjsc.example 复制生成

pipeline {
    agent any

    environment {
        CONTAINER_NAME = 'sandbox-provisioner'
        COMPOSE_SERVICE = 'sandbox-provisioner'
        COMPOSE_NETWORK = 'agent-middle-network'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(name: 'SKIP_BUILD', defaultValue: false, description: '跳过构建，仅重启容器')
        booleanParam(
            name: 'OVERWRITE_ENV',
            defaultValue: false,
            description: '强制用 .env.kjsc.example 覆盖 .env（覆盖前自动备份；会丢失工作区内对 .env 的手工修改）'
        )
    }

    stages {
        stage('检出') {
            steps {
                checkout scm
            }
        }

        stage('构建') {
            when {
                expression { return params.SKIP_BUILD?.toString() != 'true' }
            }
            steps {
                sh 'sh scripts/kjsc/build_images.sh --sandbox-provisioner'
            }
        }

        stage('部署') {
            steps {
                withEnv(["OVERWRITE_ENV=${params.OVERWRITE_ENV?.toString()}"]) {
                    sh '''
                        set -e
                        test -f .env.kjsc.example
                        if [ "$OVERWRITE_ENV" = "true" ]; then
                          if [ -f .env ]; then
                            cp .env ".env.bak.$(date +%Y%m%d%H%M%S)"
                            echo "已备份旧 .env"
                          fi
                          cp .env.kjsc.example .env
                          echo "[OVERWRITE_ENV] 已强制从 .env.kjsc.example 覆盖 .env"
                        elif [ ! -f .env ]; then
                          cp .env.kjsc.example .env
                          echo "已从 .env.kjsc.example 生成 .env"
                        else
                          echo "保留现有 .env（未勾选覆盖）"
                        fi
                        docker network inspect "$COMPOSE_NETWORK" >/dev/null 2>&1 || docker network create "$COMPOSE_NETWORK"
                        docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
                        docker compose -f docker-compose-kjsc.yml \
                          --profile harness --profile minio \
                          up -d --no-deps --force-recreate --pull never \
                          "$COMPOSE_SERVICE"
                    '''
                }
            }
        }

        stage('检查') {
            steps {
                sh '''
                    set -e
                    port=$(grep -E '^SANDBOX_PROVISIONER_PORT=' .env 2>/dev/null | tail -n1 | cut -d= -f2- | tr -d ' "\t\r' || true)
                    port=${port:-8002}
                    echo "健康检查: http://127.0.0.1:${port}/health"
                    for i in $(seq 1 30); do
                      if curl -fsS "http://127.0.0.1:${port}/health"; then
                        exit 0
                      fi
                      sleep 2
                    done
                    echo "健康检查失败"
                    docker logs --tail=50 "$CONTAINER_NAME" || true
                    exit 1
                '''
            }
        }
    }
}
