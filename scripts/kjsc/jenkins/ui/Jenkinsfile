// 前端 UI 流水线（agent-middle / kjsc）
// Jenkins Script Path: scripts/kjsc/jenkins/ui/Jenkinsfile
// 依赖：建议 app 已健康。API 变更时先跑 App Job 再跑本 Job
// 若无 .env，部署阶段会从 .env.kjsc.example 复制生成

pipeline {
    agent any

    environment {
        CONTAINER_NAME = 'agent-middle-frontend'
        COMPOSE_SERVICE = 'frontend'
        COMPOSE_NETWORK = 'agent-middle-network'
    }

    // 与 manager/Web-Jenkinsfile 相同：依赖 Jenkins 全局工具 NodeJS（名称须一致）
    tools {
        nodejs 'node20.20.2'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(name: 'SKIP_BUILD', defaultValue: false, description: '跳过构建，仅重启容器')
    }

    stages {
        stage('检出') {
            steps {
                checkout scm
            }
        }

        stage('构建') {
            when { expression { !params.SKIP_BUILD } }
            steps {
                sh 'node -v && npm -v'
                withEnv(['NODE_OPTIONS=--max-old-space-size=4096']) {
                    sh 'sh scripts/build_images_kjsc.sh -f'
                }
            }
        }

        stage('部署') {
            steps {
                sh '''
                    set -e
                    if [ ! -f .env ]; then
                      test -f .env.kjsc.example
                      cp .env.kjsc.example .env
                      echo "已从 .env.kjsc.example 生成 .env"
                    fi
                    # 网络不存在则创建（compose 中 name: agent-middle-network）
                    docker network inspect "$COMPOSE_NETWORK" >/dev/null 2>&1 || docker network create "$COMPOSE_NETWORK"
                    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true
                    docker compose -f docker-compose-kjsc.yml up -d --no-deps --force-recreate --pull never "$COMPOSE_SERVICE"
                '''
            }
        }

        stage('检查') {
            steps {
                sh '''
                    set -e
                    for i in $(seq 1 30); do
                      code=$(curl -sS -o /dev/null -w "%{http_code}" http://127.0.0.1:9980/ || echo 000)
                      case "$code" in 200|301|302|304) exit 0 ;; esac
                      sleep 2
                    done
                    docker logs --tail=50 "$CONTAINER_NAME" || true
                    exit 1
                '''
            }
        }
    }
}
